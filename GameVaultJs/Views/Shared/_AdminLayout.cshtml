<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - GameVault Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">

    <style>

            body {
                margin: 0;
                background: #f1f5f9;
                font-family: 'Segoe UI', sans-serif;
            }

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: #0f172a;
                color: white;
                overflow-y: auto;
            }

            .logo {
                padding: 25px;
                text-align: center;
                font-size: 24px;
                font-weight: bold;
                border-bottom: 1px solid #334155;
            }

                .logo span {
                    color: #60a5fa;
                }

            .menu {
                padding-top: 20px;
            }

                .menu a {
                    display: block;
                    color: #cbd5e1;
                    text-decoration: none;
                    padding: 15px 25px;
                    transition: .3s;
                }

                    .menu a:hover {
                        background: #1e293b;
                        color: white;
                    }

                .menu i {
                    width: 25px;
                }

            .content {
                margin-left: 260px;
                min-height: 100vh;
            }

            .topbar {
                background: white;
                padding: 18px 30px;
                box-shadow: 0 2px 10px rgba(0,0,0,.05);
            }

            .page-content {
                padding: 30px;
            }

            .welcome-card {
                background: white;
                border-radius: 15px;
                padding: 20px;
                box-shadow: 0 3px 10px rgba(0,0,0,.05);
            }

    </style>

</head>
<body>

    <div class="sidebar">

        <div class="logo">
            🎮 <span>GameVault</span>
            <br />
            <small style="font-size:14px;color:#94a3b8;">
                Admin Panel
            </small>
        </div>

        <div class="menu">

            <a asp-controller="Game" asp-action="Index">
                <i class="fa-solid fa-gamepad"></i>
                Games
            </a>

            <a asp-controller="Genre" asp-action="Index">
                <i class="fa-solid fa-tags"></i>
                Genres
            </a>

            <a asp-controller="Login" asp-action="Logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                Logout
            </a>

        </div>

    </div>

    <div class="content">

        <div class="topbar d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                @ViewData["Title"]
            </h4>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="text-muted small">
                    <i class="fa-solid fa-user-circle me-1"></i>
                    @User.Identity.Name
                </div>
            }

        </div>

        <div class="page-content">

            @RenderBody()

        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>