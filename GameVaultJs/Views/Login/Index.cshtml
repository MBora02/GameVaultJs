@{
    ViewData["Title"] = "GameVault Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>GameVault</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            body {
                min-height: 100vh;
                background: linear-gradient(135deg,#0f172a,#1e293b,#312e81);
                display: flex;
                justify-content: center;
                align-items: center;
                font-family: 'Segoe UI', sans-serif;
            }

            .glass-card {
                width: 450px;
                padding: 35px;
                border-radius: 25px;
                background: rgba(255,255,255,0.08);
                backdrop-filter: blur(15px);
                box-shadow: 0 8px 32px rgba(0,0,0,.3);
                border: 1px solid rgba(255,255,255,.1);
                color: white;
            }

            .logo {
                font-size: 2rem;
                font-weight: 700;
                text-align: center;
                margin-bottom: 10px;
            }

            .subtitle {
                text-align: center;
                color: #cbd5e1;
                margin-bottom: 25px;
            }

            .form-control {
                background: rgba(255,255,255,.1);
                border: none;
                color: white;
            }

                .form-control:focus {
                    background: rgba(255,255,255,.15);
                    color: white;
                    box-shadow: none;
                }

                .form-control::placeholder {
                    color: #cbd5e1;
                }

            .btn-admin {
                background: #4f46e5;
                border: none;
            }

                .btn-admin:hover {
                    background: #4338ca;
                }

            .btn-user {
                background: #06b6d4;
                border: none;
            }

                .btn-user:hover {
                    background: #0891b2;
                }

            .register-link {
                text-align: center;
                margin-top: 20px;
                color: #cbd5e1;
            }

                .register-link a {
                    color: white;
                    text-decoration: none;
                }

                    .register-link a:hover {
                        text-decoration: underline;
                    }
    </style>

</head>
<body>

    <div class="glass-card">

        <div class="logo">
            🎮 GameVault
        </div>

        <div class="subtitle">
            Game Management Platform
        </div>

        <div class="mb-3">
            <input type="email"
                   class="form-control"
                   placeholder="Email Address">
        </div>

        <div class="mb-4">
            <input type="password"
                   class="form-control"
                   placeholder="Password">
        </div>

        <div class="d-grid gap-3">

            <a asp-controller="Login"
               asp-action="AdminLogin"
               class="btn btn-admin btn-lg">
                Login as Admin
            </a>

            <a asp-controller="Login"
               asp-action="UserLogin"
               class="btn btn-user btn-lg">
                Login as User
            </a>

        </div>

        <div class="register-link">
            Don't have an account?
            <a href="#">Register</a>
        </div>

    </div>

</body>
</html>